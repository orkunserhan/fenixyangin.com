# FENIX.COM Apache .htaccess Configuration
RewriteEngine On
RewriteBase /

# 1. Force HTTPS & WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?fenixyangin\.com$ [NC]
RewriteRule ^ https://www.fenixyangin.com%{REQUEST_URI} [L,R=301]

# 2. Trailing Slash Enforcement for Directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

# 3. Production Security Headers
<IfModule mod_headers.c>
    # HTTP Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Clickjacking Protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    
    # Content Security Policy (GA4, Google Maps, Fonts, YouTube, WhatsApp Ready)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://wa.me https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me;"
</IfModule>

# 4. Custom 404 Error Document
ErrorDocument 404 /404.html

# 5. Core 301 Redirect Rules (Full 1,326 rules available in FENIX_OLD_COM_301_MAP.md)
Redirect 301 /fm200-gazli-sondurme-sistemi/ /sistemler/fm200/
Redirect 301 /novec-1230-yangin-sondurme-sistemleri/ /sistemler/novec-1230/
Redirect 301 /hizmetler/novec-1230-gazli-sondurme-sistemi/ /sistemler/novec-1230/
Redirect 301 /hizmetler/co2-gazli-sondurme-sistemleri/ /sistemler/co2/
Redirect 301 /hizmetler/karbondioksit-gazli-sondurme-sistemleri/ /sistemler/co2/
Redirect 301 /hizmetler/elektrik-panosu-yangin-sondurme-sistemleri/ /sistemler/pano-ici/
Redirect 301 /hizmetler/davlumbaz-sondurme-sistemi-2/ /sistemler/davlumbaz/
Redirect 301 /hizmetler/su-sisi-sondurme-sistemleri/ /sistemler/aerosol/
Redirect 301 /hizmetler/fm200-yangin-sondurme-sistemleri-dolumu/ /hizmetler/dolum/
Redirect 301 /hizmetler/novec-1230-gazli-sondurme-sistemi-dolumu/ /hizmetler/dolum/
Redirect 301 /hizmetler/gazli-yangin-sondurme-sistemleri-bakimi/ /hizmetler/bakim/
Redirect 301 /hizmetler/door-fan-test-oda-sizdirmazlik-testi/ /teknik-icerikler/oda-sizdirmazlik-testi-yontemi/
Redirect 301 /hizmetler/gazli-sondurme-sistemleri/ /sistemler/
